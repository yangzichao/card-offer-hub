{
    "id": "citi-offer-lite",
    "name": "Citi Offer Lite",
    "description": "Manually select Citi cards, scan Merchant Offers, and enroll all available offers serially",
    "author": "Zichao Yang",
    "issuer": "citi",
    "matches": [
        "https://*.citi.com/*"
    ],
    "grants": [
        "GM_getValue",
        "GM_setValue"
    ],
    "connects": [],
    "runAt": "document-idle",
    "noFrames": true,
    "sharedModules": [
        "ui/design-system.js",
        "ui/panel-branding.js",
        "ui/workflow-layout.js",
        "persistence/workspace-records.js",
        "persistence/workspace-storage.js",
        "persistence/workspace-scope.js",
        "persistence/workspace-ui.js",
        "runtime/request-scheduler.js",
        "runtime/json-transport.js",
        "runtime/action-runner.js",
        "persistence/pacing-storage.js",
        "offers/display-records.js",
        "ui/workflow-panel.js",
        "runtime/action-lifecycle.js",
        "pacing/policy.js",
        "pacing/profile.js",
        "pacing/learning.js",
        "pacing/controller.js",
        "ui/pacing-details.js"
    ],
    "sources": [
        "snapshots/saved-results.js",
        "core/state.js",
        "core/workflow.js",
        "core/storage.js",
        "core/workspace-fields.js",
        "core/workspace.js",
        "api/session.js",
        "api/request-runtime.js",
        "api/transport.js",
        "api/contracts.js",
        "workflows/runner.js",
        "workflows/cards.js",
        "workflows/scanning.js",
        "workflows/offers.js",
        "workflows/saved-offers.js",
        "ui/styles.js",
        "ui/panel.js",
        "ui/actions.js",
        "ui/render.js",
        "initialize.js"
    ],
    "bankLabel": "Citi",
    "offersUrl": "https://online.citi.com/US/nga/products-offers/merchantoffers",
    "savedResultsSource": "snapshots/saved-results.js",
    "capabilities": {
        "activation": true,
        "scope": "card"
    },
    "workflow": "per-card",
    "adapterMatches": [
        "https://online.citi.com/*"
    ]
}
