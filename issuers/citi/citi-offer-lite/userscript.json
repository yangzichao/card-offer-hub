{
    "id": "citi-offer-lite",
    "name": "Citi Offer Lite",
    "version": "1.3.0",
    "description": "Manually select Citi cards, scan Merchant Offers, and enroll all available offers serially",
    "author": "Zichao Yang",
    "issuer": "citi",
    "matches": [
        "https://online.citi.com/US/*"
    ],
    "grants": [
        "GM_getValue",
        "GM_setValue"
    ],
    "connects": [],
    "runAt": "document-idle",
    "noFrames": true,
    "sharedModules": [
        "ui/design-system.js",
        "ui/panel-branding.js",
        "ui/workflow-layout.js",
        "persistence/workspace-records.js",
        "persistence/workspace-storage.js",
        "persistence/workspace-scope.js",
        "persistence/workspace-ui.js"
    ],
    "sources": [
        "core/state.js",
        "core/storage.js",
        "core/workspace-fields.js",
        "api/session.js",
        "api/transport.js",
        "api/contracts.js",
        "workflows/runner.js",
        "workflows/offers.js",
        "ui/styles.js",
        "ui/panel.js",
        "ui/render.js",
        "initialize.js"
    ],
    "bankLabel": "Citi",
    "offersUrl": "https://online.citi.com/US/nga/products-offers/merchantoffers"
}
