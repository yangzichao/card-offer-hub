{
    "id": "amex-offer-lite",
    "name": "Amex Offer Lite",
    "description": "Detect cards, rank them by drag, scan Offers Hub slowly, and add every offer to one card at a time",
    "author": "Zichao Yang",
    "issuer": "amex",
    "matches": [
        "https://*.americanexpress.com/*"
    ],
    "grants": [
        "GM_getValue",
        "GM_setValue",
        "unsafeWindow"
    ],
    "connects": [],
    "runAt": "document-idle",
    "noFrames": true,
    "sharedModules": [
        "ui/design-system.js",
        "ui/panel-branding.js",
        "ui/workflow-layout.js",
        "runtime/request-scheduler.js",
        "offers/display-records.js",
        "runtime/action-lifecycle.js",
        "pacing/policy.js",
        "pacing/profile.js",
        "pacing/learning.js",
        "pacing/controller.js",
        "persistence/pacing-storage.js",
        "ui/pacing-details.js",
        "diagnostics/pacing-records.js",
        "diagnostics/pacing-storage.js",
        "diagnostics/pacing-download.js"
    ],
    "sources": [
        "snapshots/saved-results.js",
        "core/state.js",
        "core/workflow.js",
        "core/card-priority.js",
        "core/storage.js",
        "core/view-settings.js",
        "core/saved-cards.js",
        "core/offer-snapshots.js",
        "core/saved-offers.js",
        "core/page-state.js",
        "core/offer-statistics.js",
        "api/requests.js",
        "api/opaque-rate-limit.js",
        "api/transport.js",
        "api/accounts.js",
        "api/offers.js",
        "api/enrollment-contract.js",
        "api/enrollment.js",
        "workflows/runner.js",
        "workflows/cards.js",
        "workflows/scan-results.js",
        "workflows/scan.js",
        "workflows/enrollment-plan.js",
        "workflows/enrollment-requests.js",
        "workflows/enrollment-outcomes.js",
        "workflows/enrollment.js",
        "ui/styles.js",
        "ui/panel.js",
        "ui/card-priority.js",
        "ui/cards.js",
        "ui/offers.js",
        "ui/render.js",
        "initialize.js"
    ],
    "bankLabel": "Amex",
    "offersUrl": "https://global.americanexpress.com/offers",
    "savedResultsSource": "snapshots/saved-results.js",
    "capabilities": {
        "activation": true,
        "scope": "card"
    },
    "workflow": "amex-combination",
    "adapterMatches": [
        "https://global.americanexpress.com/*"
    ]
}
