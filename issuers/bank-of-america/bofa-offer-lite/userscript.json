{
    "id": "bofa-offer-lite",
    "name": "BankAmeriDeals Lite",
    "description": "Manually scan and activate ordinary card-linked BankAmeriDeals with verified results",
    "author": "Zichao Yang",
    "issuer": "bank-of-america",
    "matches": [
        "https://deals.merchant-rewards.com/*"
    ],
    "grants": [
        "GM_getValue",
        "GM_setValue"
    ],
    "connects": [],
    "runAt": "document-idle",
    "noFrames": true,
    "sharedModules": [
        "ui/design-system.js",
        "ui/panel-branding.js",
        "ui/workflow-layout.js",
        "persistence/workspace-records.js",
        "persistence/workspace-storage.js",
        "persistence/workspace-scope.js",
        "persistence/workspace-ui.js",
        "runtime/request-scheduler.js",
        "runtime/json-transport.js",
        "runtime/action-runner.js",
        "persistence/pacing-storage.js",
        "offers/display-records.js",
        "ui/workflow-panel.js",
        "runtime/action-lifecycle.js"
    ],
    "sources": [
        "snapshots/saved-results.js",
        "core/state.js",
        "core/workflow.js",
        "core/storage.js",
        "core/workspace-fields.js",
        "core/workspace.js",
        "api/session.js",
        "api/request-runtime.js",
        "api/transport.js",
        "api/contracts.js",
        "workflows/runner.js",
        "workflows/offers.js",
        "ui/panel.js",
        "ui/render.js",
        "initialize.js"
    ],
    "bankLabel": "BankAmeriDeals",
    "offersUrl": "https://deals.merchant-rewards.com/",
    "savedResultsSource": "snapshots/saved-results.js",
    "capabilities": {
        "activation": true,
        "scope": "account"
    },
    "workflow": "account"
}
