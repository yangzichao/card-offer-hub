{
    "id": "chase-offer-lite",
    "name": "Chase Offer Lite",
    "description": "Manually select Chase cards and scan Chase Offers serially; read-only until activation is verified",
    "author": "Zichao Yang",
    "issuer": "chase",
    "matches": [
        "https://secure.chase.com/web/auth/*"
    ],
    "grants": [
        "GM_getValue",
        "GM_setValue",
        "unsafeWindow"
    ],
    "connects": [],
    "runAt": "document-start",
    "noFrames": true,
    "sharedModules": [
        "ui/design-system.js",
        "ui/panel-branding.js",
        "ui/workflow-layout.js",
        "persistence/workspace-records.js",
        "persistence/workspace-storage.js",
        "persistence/workspace-scope.js",
        "persistence/workspace-ui.js",
        "runtime/request-scheduler.js",
        "runtime/json-transport.js",
        "runtime/action-runner.js",
        "persistence/pacing-storage.js",
        "offers/display-records.js",
        "ui/workflow-panel.js",
        "runtime/action-lifecycle.js"
    ],
    "sources": [
        "snapshots/saved-results.js",
        "core/state.js",
        "core/workflow.js",
        "core/storage.js",
        "core/workspace-fields.js",
        "core/workspace.js",
        "api/contracts.js",
        "api/session.js",
        "api/request-runtime.js",
        "api/observer.js",
        "core/transport.js",
        "workflows/runner.js",
        "workflows/offers.js",
        "ui/styles.js",
        "ui/panel.js",
        "ui/render.js",
        "initialize.js"
    ],
    "bankLabel": "Chase",
    "offersUrl": "https://secure.chase.com/web/auth/dashboard",
    "savedResultsSource": "snapshots/saved-results.js",
    "capabilities": {
        "activation": false,
        "scope": "card"
    },
    "workflow": "per-card"
}
