{
    "id": "usbank-offer-lite",
    "name": "US Bank Offer Lite",
    "description": "Manually scan and select US Bank Cash Back Deals, activate serially, and verify server state",
    "author": "Zichao Yang",
    "issuer": "usbank",
    "matches": [
        "https://*.usbank.com/*"
    ],
    "grants": [
        "GM_getValue",
        "GM_setValue"
    ],
    "connects": [],
