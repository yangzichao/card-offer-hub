    "noFrames": true,
    "sharedModules": [
        "ui/design-system.js",
        "ui/panel-branding.js",
        "ui/workflow-layout.js",
        "persistence/workspace-records.js",
        "persistence/workspace-storage.js",
        "persistence/workspace-scope.js",
        "persistence/workspace-ui.js",
        "runtime/request-scheduler.js",
        "runtime/json-transport.js",
        "runtime/action-runner.js",
        "persistence/pacing-storage.js",
        "offers/display-records.js",
        "ui/workflow-panel.js",
        "runtime/action-lifecycle.js",
        "pacing/policy.js",
        "pacing/profile.js",
        "pacing/learning.js",
        "pacing/controller.js",
        "ui/pacing-details.js",
        "diagnostics/pacing-records.js",
        "diagnostics/pacing-storage.js",
        "diagnostics/pacing-download.js"
    ],
    "sources": [
        "snapshots/saved-results.js",
        "core/state.js",
        "core/workflow.js",
        "core/storage.js",
        "core/workspace-fields.js",
        "core/workspace.js",
        "api/session.js",
        "api/request-runtime.js",
        "api/queries.js",
        "api/contracts.js",
        "api/transport.js",
        "workflows/runner.js",
        "workflows/offers.js",
        "ui/styles.js",
        "ui/panel.js",
        "ui/render.js",
        "initialize.js"
    ],
    "bankLabel": "US Bank",
    "offersUrl": "https://onlinebanking.usbank.com/digital/servicing/dominjection/cashback-deals",
    "savedResultsSource": "snapshots/saved-results.js",
    "capabilities": {
        "activation": true,
        "scope": "account"
    },
    "workflow": "account",
    "adapterMatches": [
        "https://onlinebanking.usbank.com/*"
    ]
}
