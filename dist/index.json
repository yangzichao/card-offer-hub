{
    "schemaVersion": 2,
    "repository": "https://github.com/yangzichao/card-offer-hub",
    "publishBranch": "main",
    "scripts": [
        {
            "id": "card-offer-hub-all",
            "name": "Card Offer Hub — All Banks",
            "version": "1.4.3",
            "description": "All six Card Offer Hub tools in one install; manual scanning and activation on the matching bank website",
            "matches": [
                "https://*.americanexpress.com/*",
                "https://*.bankofamerica.com/*",
                "https://deals.merchant-rewards.com/*",
                "https://*.chase.com/*",
                "https://*.citi.com/*",
                "https://*.usbank.com/*",
                "https://*.wellsfargo.com/*"
            ],
            "publishedFile": "dist/card-offer-hub-all.user.js",
            "installUrl": "https://raw.githubusercontent.com/yangzichao/card-offer-hub/main/dist/card-offer-hub-all.user.js",
            "updateUrl": "https://raw.githubusercontent.com/yangzichao/card-offer-hub/main/dist/card-offer-hub-all.user.js",
            "includes": [
                {
                    "id": "amex-offer-lite",
                    "name": "Amex Offer Lite",
                    "issuer": "amex",
                    "matches": [
                        "https://*.americanexpress.com/*"
                    ],
                    "adapterMatches": [
                        "https://global.americanexpress.com/*"
                    ],
                    "offersUrl": "https://global.americanexpress.com/offers",
                    "sourceDirectory": "issuers/amex/amex-offer-lite"
                },
                {
                    "id": "bofa-offer-lite",
                    "name": "BankAmeriDeals Lite",
                    "issuer": "bank-of-america",
                    "matches": [
                        "https://*.bankofamerica.com/*",
                        "https://deals.merchant-rewards.com/*"
                    ],
                    "adapterMatches": [
                        "https://deals.merchant-rewards.com/*"
                    ],
                    "offersUrl": "https://deals.merchant-rewards.com/",
                    "sourceDirectory": "issuers/bank-of-america/bofa-offer-lite"
                },
                {
                    "id": "chase-offer-lite",
                    "name": "Chase Offer Lite",
                    "issuer": "chase",
                    "matches": [
                        "https://*.chase.com/*"
                    ],
                    "adapterMatches": [
                        "https://secure.chase.com/*"
                    ],
                    "offersUrl": "https://secure.chase.com/web/auth/dashboard",
                    "sourceDirectory": "issuers/chase/chase-offer-lite"
                },
                {
                    "id": "citi-offer-lite",
                    "name": "Citi Offer Lite",
                    "issuer": "citi",
                    "matches": [
                        "https://*.citi.com/*"
                    ],
                    "adapterMatches": [
                        "https://online.citi.com/*"
                    ],
                    "offersUrl": "https://online.citi.com/US/nga/products-offers/merchantoffers",
                    "sourceDirectory": "issuers/citi/citi-offer-lite"
                },
                {
                    "id": "usbank-offer-lite",
                    "name": "US Bank Offer Lite",
                    "issuer": "usbank",
                    "matches": [
                        "https://*.usbank.com/*"
                    ],
                    "adapterMatches": [
                        "https://onlinebanking.usbank.com/*"
                    ],
                    "offersUrl": "https://onlinebanking.usbank.com/digital/servicing/dominjection/cashback-deals",
                    "sourceDirectory": "issuers/usbank/usbank-offer-lite"
                },
                {
                    "id": "wellsfargo-offer-lite",
                    "name": "Wells Fargo Offer Lite",
                    "issuer": "wellsfargo",
                    "matches": [
                        "https://*.wellsfargo.com/*"
                    ],
                    "adapterMatches": [
                        "https://web.secure.wellsfargo.com/*"
                    ],
                    "offersUrl": "https://web.secure.wellsfargo.com/auth/deals-portal",
                    "sourceDirectory": "issuers/wellsfargo/wellsfargo-offer-lite"
                }
            ]
        }
    ]
}
